# Store-upload credentials for scripts/release.sh (copy to .env.release — gitignored)

# App Store Connect → Users and Access → Integrations → App Store Connect API → Team key (role: App Manager)
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
ASC_TEAM_ID=CN9WDS6BJW

# Play Console → Setup → API access → service account with "Release to production" on the app
PLAY_SERVICE_ACCOUNT_JSON=/path/to/play-service-account.json
PLAY_TRACK=production        # internal | alpha | beta | production
# PLAY_STATUS=draft          # completed (default) | draft | inProgress
